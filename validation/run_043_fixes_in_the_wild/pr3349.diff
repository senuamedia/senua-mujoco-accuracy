+      int pi = pa_find(d, nbody, bA, bB);
+      if (pi < 0) continue;                                 // no anchor yet: kinetic (damper) only
+      const int* key = d->fricpair + mjPA_NKEY*pi;
+      const mjtNum* a = d->fricanchor + mjPA_NPOSE*pi;
