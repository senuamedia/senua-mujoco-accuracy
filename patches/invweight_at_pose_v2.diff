 //------------------------ compute constraint parameters -------------------------------------------
 
 // compute diagApprox
+// Senua AI patch, in design: MUJOCO_INVWEIGHT_AT_POSE=1 takes each body's inverse weight, which sets the
+// regularisation of a contact, in the pose the bodies are in, by the formula mj_setConst uses for body_invweight0 in
+// the pose a model is written in (qpos0); read once, so every thread reads the same value
+static int mj_invweightAtPose(void) {
+  static int on = -1;
+  if (on < 0) {
+    const char* sw = getenv("MUJOCO_INVWEIGHT_AT_POSE");
+    on = (sw && sw[0] == '1' && sw[1] == 0) ? 1 : 0;
+  }
+  return on;
+}
+
+// Senua AI patch, in design: body b's translational and rotational inverse weight in the current pose, computed as
+// engine_setconst.c computes body_invweight0 in qpos0
+static void mj_bodyInvweightAtPose(const mjModel* m, mjData* d, int b, mjtNum res[2]) {
+  int nv = m->nv;
+  if (m->body_dofnum[m->body_weldid[b]] == 0) {
+    res[0] = res[1] = 0;
+  } else if (m->body_simple[b] == 2) {
+    res[0] = 1/mju_max(mjMINVAL, m->body_mass[b]);
+    res[1] = 0;
+  } else {
+    mj_markStack(d);
+    mjtNum* jac = mjSTACKALLOC(d, 6*nv, mjtNum);
+    mjtNum* tmp = mjSTACKALLOC(d, 6*nv, mjtNum);
+    mjtNum A[36];
+    mj_jacBodyCom(m, d, jac, jac+3*nv, b);
+    mj_solveM(m, d, tmp, jac, 6);
+    mju_mulMatMatT(A, jac, tmp, 6, nv, 6);
+    res[0] = (A[0] + A[7] + A[14])/3;
+    res[1] = (A[21] + A[28] + A[35])/3;
+    mj_freeStack(d);
+  }
+}
+
+
+// Senua AI patch, in design: the inverse weight of the joint that owns dof `dof`, in the current pose, computed as
+// engine_setconst.c computes dof_invweight0 in qpos0
+static mjtNum mj_dofInvweightAtPose(const mjModel* m, mjData* d, int dof) {
+  int nv = m->nv, j = m->dof_jntid[dof], id = m->jnt_dofadr[j], dnum;
+  if (m->body_simple[m->jnt_bodyid[j]] == 2) {
+    return 1/mju_max(mjMINVAL, m->body_mass[m->jnt_bodyid[j]]);
+  }
+  if (m->jnt_type[j] == mjJNT_FREE) {
+    dnum = 6;
+  } else if (m->jnt_type[j] == mjJNT_BALL) {
+    dnum = 3;
+  } else {
+    dnum = 1;
+  }
+  mj_markStack(d);
+  mjtNum* jac = mjSTACKALLOC(d, dnum*nv, mjtNum);
+  mjtNum* tmp = mjSTACKALLOC(d, dnum*nv, mjtNum);
+  mjtNum A[36];
+  mju_zero(jac, dnum*nv);
+  for (int k=0; k < dnum; k++) {
+    jac[k*(nv+1) + id] = 1;
+  }
+  mj_solveM(m, d, tmp, jac, dnum);
+  mju_mulMatMatT(A, jac, tmp, dnum, nv, dnum);
+  mjtNum res;
+  if (dnum == 6) {
+    res = (dof - id < 3) ? (A[0] + A[7] + A[14])/3 : (A[21] + A[28] + A[35])/3;
+  } else if (dnum == 3) {
+    res = (A[0] + A[4] + A[8])/3;
+  } else {
+    res = A[0];
+  }
+  mj_freeStack(d);
+  return res;
+}
+
