diff -ru a/src/engine/engine_core_constraint.c b/src/engine/engine_core_constraint.c
--- a/src/engine/engine_core_constraint.c	2026-10-15 15:56:29
+++ b/src/engine/engine_core_constraint.c	2026-10-15 15:57:41
@@ -1444,12 +1444,69 @@
       continue;
     }
 
+    // Senua AI patch, in design (off unless MUJOCO_SLIP_ALIGNED_PYRAMID=1): a pyramidal cone's edges lie along the
+    // contact frame's two tangents, so the friction it can give is a diamond, |f1| + |f2| <= mu N, and a contact
+    // slipping at 45 degrees to them gets only 0.707 of Coulomb's friction. Turn the pyramid's basis about the normal
+    // so its first tangent lies along the slip, for the rows built below only: the frame is restored after them, so
+    // every output that reads it is as released, and the turn is kept in frictionrot for mj_contactForce and
+    // mj_addSurfaceVel. The slip is the contact's relative velocity: its Jacobian difference times qvel, plus the
+    // surfaces' own velocity (surfacevel), as MuJoCo's contact velocity is (mj_velocityConstraint). A contact is
+    // turned only when its slip is at least opt.sleep_tolerance, the speed below which MuJoCo itself treats a body
+    // as at rest (treeCanSleep, engine_sleep.c), and only when its two sliding frictions (and its two rolling
+    // frictions) are equal, so that turning the basis changes its direction and nothing else.
+    mjtNum frame_saved[6];
+    int turned = 0;
+    if (mj_slipAlignedPyramid()) {
+      con->frictionrot[0] = 1;
+      con->frictionrot[1] = 0;
+      if (ispyramid && dim >= 3 && con->friction[0] == con->friction[1] &&
+          (dim < 6 || con->friction[3] == con->friction[4])) {
+        mjtNum vrel[3] = {0, 0, 0};
+        for (int r=0; r < 3; r++) {
+          for (int j=0; j < NV; j++) {
+            vrel[r] += jacdifp[r*NV + j] * d->qvel[issparse ? chain[j] : j];
+          }
+        }
+        if (m->flg_surfacevel) {
+          for (int side=0; side < 2; side++) {
+            int g = con->geom[side];
+            if (g < 0) {
+              continue;
+            }
+            const mjtNum* sv = m->geom_surfacevel + 6*g;
+            if (!sv[0] && !sv[1] && !sv[2] && !sv[3] && !sv[4] && !sv[5]) {
+              continue;
+            }
+            mjtNum vw[3], ww[3];
+            mj_geomSurfaceVelocity(m, d, g, con->pos, vw, ww);
+            mju_addToScl3(vrel, vw, side ? 1 : -1);
+          }
+        }
+        mjtNum vt[3], t2[3];
+        mju_addScl3(vt, vrel, con->frame, -mju_dot3(vrel, con->frame));  // the slip: vrel less its normal part
+        if (mju_normalize3(vt) >= m->opt.sleep_tolerance) {
+          mju_copy(frame_saved, con->frame+3, 6);
+          con->frictionrot[0] = mju_dot3(vt, frame_saved);    // cos: along the frame's first tangent
+          con->frictionrot[1] = mju_dot3(vt, frame_saved+3);  // sin: along its second
+          mju_cross(t2, con->frame, vt);
+          mju_copy3(con->frame+3, vt);
+          mju_copy3(con->frame+6, t2);
+          turned = 1;
+        }
+      }
+    }
+
     // rotate Jacobian differences to contact frame
     mju_mulMatMat(jac, con->frame, jacdifp, dim > 1 ? 3 : 1, 3, NV);
     if (dim > 3) {
       mju_mulMatMat(jac + 3*NV, con->frame, jacdifr, dim-3, 3, NV);
     }
 
+    // Senua AI patch, in design: the frame as the release computed it, for every output that reads it
+    if (turned) {
+      mju_copy(con->frame+3, frame_saved, 6);
+    }
+
     // make frictionless contact
     if (dim == 1) {
       // add constraint
@@ -3113,6 +3170,13 @@
     mjtNum cs[6];
     mju_mulMatVec3(cs, con->frame, svel);
     mju_mulMatVec3(cs + 3, con->frame, sang);
+
+    // Senua AI patch, in design: a turned pyramid's rows take the surface velocity in the turned basis
+    if (mj_slipAlignedPyramid() && ispyramid && con->dim >= 3) {
+      mjtNum c = con->frictionrot[0], s = con->frictionrot[1], v1 = cs[1], v2 = cs[2];
+      cs[1] = c*v1 + s*v2;
+      cs[2] = -s*v1 + c*v2;
+    }
 
     // surface velocity acts in the tangent plane and torsional direction only
     cs[0] = 0;  // no normal push
