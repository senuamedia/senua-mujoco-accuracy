 #include <mujoco/mjmacro.h>
@@ -1390,6 +1391,16 @@
 
 
 // extract 6D force:torque for one contact, in contact frame
+// Senua AI patch, in design: the switch of the slip-aligned pyramid, read once; every thread reads the same value
+int mj_slipAlignedPyramid(void) {
+  static int on = -1;
+  if (on < 0) {
+    const char* sw = getenv("MUJOCO_SLIP_ALIGNED_PYRAMID");
+    on = (sw && sw[0] == '1' && sw[1] == 0) ? 1 : 0;
+  }
+  return on;
+}
+
 void mj_contactForce(const mjModel* m, const mjData* d, int id, mjtNum result[6]) {
   mjContact* con;
 
@@ -1403,6 +1414,19 @@
 
     if (mj_isPyramidal(m)) {
       mju_decodePyramid(result, d->efc_force + con->efc_address, con->friction, con->dim);
+      // Senua AI patch, in design: the pyramid's basis was turned from the frame's tangents by mj_instantiateContact;
+      // turn the decoded tangential forces and rolling torques back, so the result is in the contact frame
+      if (mj_slipAlignedPyramid() && con->dim >= 3) {
+        mjtNum c = con->frictionrot[0], s = con->frictionrot[1];
+        mjtNum f1 = result[1], f2 = result[2];
+        result[1] = c*f1 - s*f2;
+        result[2] = s*f1 + c*f2;
+        if (con->dim == 6) {
+          mjtNum r1 = result[4], r2 = result[5];
+          result[4] = c*r1 - s*r2;
+          result[5] = s*r1 + c*r2;
+        }
+      }
     } else {
       mju_copy(result, d->efc_force + con->efc_address, con->dim);
     }
