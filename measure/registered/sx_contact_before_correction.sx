    xc_lbl("RULE "); xc_puts(load_i64(argv, 2)); print_char(32); xc_puts(load_i64(argv, 3)); xc_list(argv, 4, argc - 4);
    xc_lbl(if v == 1 { " : HELD" } else { " : FAILED" }); print_char(10);
    42
}
fn xc_usage() -> i64 { xc_lbl("usage: sx_contact bounce <file> | impact <file> | settle <file> | creep <file> | pull <file> | rest <file> | swing <file> | final <file> | slip <file> <push mN> | stop <file> | accel <file> <from ms> <to ms> | pair <file A> <file B> | gap <base step ns> <file> <file> | verdict <52 numbers> | suite <48 numbers> | ledger <20 numbers> | joints <20 numbers> | ledger7 <105 numbers> | leave <file> <limit urad> | limits <57 numbers> | rotvec <file> <bound ppm> | trace <trace> <limit> <from step> | flight <file A> <trace> <limit> | ends <file> <file> | suite2 <37 numbers> | study9 <75 numbers>\n"); 1 }
